---
import type { ImageMetadata } from "astro";

import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";
import { siteConfig } from "../content/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  image?: ImageMetadata;
  bodyClass?: string;
}

const { title, description, canonicalPath, image, bodyClass } = Astro.props;
const canonical = siteConfig.siteUrl
  ? new URL(canonicalPath, siteConfig.siteUrl).toString()
  : undefined;
const socialImage =
  canonical && image ? new URL(image.src, canonical).toString() : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b0c" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    <title>{title}</title>
    <script is:inline>
      document.documentElement.dataset.js = "true";
    </script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#contenido-principal">
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido-principal">
      <slot />
    </main>
    <Footer />
  </body>
</html>
