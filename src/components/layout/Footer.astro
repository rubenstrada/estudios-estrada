---
import { navigation, siteConfig } from "../../content/site";
import BrandLogo from "../ui/BrandLogo.astro";
import AvailabilityLink from "../ui/AvailabilityLink.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__main site-container">
    <div class="site-footer__identity">
      <a href="/" aria-label="Estudios Estrada, inicio">
        <BrandLogo variant="gold" class="site-footer__logo" />
      </a>
      <p>
        Fotografía profesional y producción audiovisual para personas, eventos y
        empresas.
      </p>
    </div>

    <div>
      <p class="site-footer__heading">Explora</p>
      <nav aria-label="Navegación del pie">
        <ul>
          {navigation.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="site-footer__contact">
      <p class="site-footer__heading">Hablemos de tu proyecto</p>
      <AvailabilityLink placement="footer" />
      {siteConfig.contactChannels.length > 0 && (
        <ul>
          {siteConfig.contactChannels.map((channel) => (
            <li>
              <a href={channel.href}>{channel.label}</a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>

  <div class="site-footer__legal site-container">
    <p>© {year} Estudios Estrada.</p>
    <a href="/contacto#privacidad">Aviso de privacidad</a>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(4rem, 8vw, 7rem) 1.5rem;
    border-top: 1px solid var(--color-border-dark);
    background: var(--color-ink);
    color: var(--color-ivory);
  }

  .site-footer__main {
    display: grid;
    gap: 3rem;
  }

  .site-footer__identity {
    display: grid;
    max-width: 24rem;
    gap: 1.25rem;
  }

  :global(.site-footer__logo) {
    width: 10rem;
    height: auto;
  }

  .site-footer__identity p,
  .site-footer__legal {
    color: rgb(246 242 233 / 66%);
  }

  .site-footer__heading {
    margin-bottom: 1rem;
    color: var(--color-gold-bright);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    text-decoration-color: transparent;
    transition: color 160ms ease;
  }

  a:hover {
    color: var(--color-gold-bright);
  }

  .site-footer__contact {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 1rem;
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border-dark);
    font-size: 0.8rem;
  }

  @media (min-width: 48rem) {
    .site-footer__main {
      grid-template-columns: 1.35fr 0.75fr 1fr;
    }
  }
</style>
