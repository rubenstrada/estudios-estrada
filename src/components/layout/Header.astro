---
import { navigation } from "../../content/site";
import BrandLogo from "../ui/BrandLogo.astro";
import AvailabilityLink from "../ui/AvailabilityLink.astro";
import MobileNavigation from "./MobileNavigation.astro";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header" data-site-header data-scrolled="false">
  <div class="site-header__inner site-container">
    <a
      class="site-header__brand"
      href="/"
      aria-label="Estudios Estrada, inicio"
    >
      <BrandLogo variant="gold" priority class="site-header__logo" />
    </a>

    <nav
      class="desktop-navigation"
      aria-label="Navegación principal"
      data-desktop-nav
    >
      <ul>
        {navigation.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={currentPath === item.href ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <AvailabilityLink placement="header" class="site-header__cta" />
      <button
        class="menu-trigger"
        type="button"
        aria-expanded="false"
        aria-controls="navegacion-movil"
        aria-label="Abrir menú"
        data-menu-trigger
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <MobileNavigation currentPath={currentPath} />
</header>

<script>
  import "../../scripts/header";
</script>

<style>
  .site-header {
    position: sticky;
    z-index: var(--z-header);
    top: 0;
    border-bottom: 1px solid transparent;
    background: var(--color-ink);
    color: var(--color-ivory);
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .site-header[data-scrolled="true"] {
    border-color: var(--color-border-dark);
    background: rgb(11 11 12 / 94%);
    box-shadow: 0 0.5rem 2rem rgb(0 0 0 / 16%);
    backdrop-filter: blur(1rem);
  }

  .site-header__inner {
    display: grid;
    min-height: 4.75rem;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
  }

  .site-header__brand {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    text-decoration: none;
  }

  :global(.site-header__logo) {
    width: 5.5rem;
    height: 3.8rem;
    object-fit: contain;
    object-position: center;
  }

  .desktop-navigation,
  :global(.site-header__cta) {
    display: none;
  }

  .desktop-navigation ul {
    display: flex;
    align-items: center;
    gap: clamp(0.85rem, 1.7vw, 1.6rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .desktop-navigation a {
    position: relative;
    padding-block: 0.65rem;
    color: rgb(246 242 233 / 78%);
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .desktop-navigation a::after {
    position: absolute;
    right: 0;
    bottom: 0.28rem;
    left: 0;
    height: 1px;
    transform: scaleX(0);
    background: var(--color-gold-bright);
    content: "";
    transform-origin: left;
    transition: transform 160ms ease;
  }

  .desktop-navigation a:hover,
  .desktop-navigation a[aria-current="page"] {
    color: var(--color-ivory);
  }

  .desktop-navigation a:hover::after,
  .desktop-navigation a[aria-current="page"]::after {
    transform: scaleX(1);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .menu-trigger {
    display: none;
    width: 3rem;
    height: 3rem;
    padding: 0.75rem;
    border: 1px solid var(--color-border-dark);
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  :global(html[data-js="true"]) .menu-trigger {
    display: grid;
    align-content: center;
    gap: 0.35rem;
  }

  .menu-trigger span {
    display: block;
    width: 100%;
    height: 1px;
    background: currentColor;
    transition: transform 160ms ease;
  }

  .menu-trigger[aria-expanded="true"] span:first-child {
    transform: translateY(0.18rem) rotate(45deg);
  }

  .menu-trigger[aria-expanded="true"] span:last-child {
    transform: translateY(-0.18rem) rotate(-45deg);
  }

  @media (min-width: 64rem) {
    .site-header__inner {
      min-height: 5.5rem;
      grid-template-columns: auto 1fr auto;
    }

    :global(.site-header__logo) {
      width: 6.5rem;
      height: 4.3rem;
    }

    .desktop-navigation {
      display: block;
      justify-self: center;
    }

    :global(.site-header__cta) {
      display: inline-flex;
    }

    .menu-trigger,
    :global(html[data-js="true"]) .menu-trigger {
      display: none;
    }
  }
</style>
