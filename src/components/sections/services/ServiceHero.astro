---
import type { MediaItem } from "../../../content/types";
import type { AvailabilityInquiry } from "../../../lib/whatsapp";
import Reveal from "../../motion/Reveal.astro";
import AvailabilityLink from "../../ui/AvailabilityLink.astro";
import ButtonLink from "../../ui/ButtonLink.astro";

interface Props {
  eyebrow: string;
  title: string;
  introduction: string;
  media?: MediaItem;
  inquiry: AvailabilityInquiry;
}

const { eyebrow, title, introduction, media, inquiry } = Astro.props;
---

<section class="service-hero">
  <div class="service-hero__grid site-container">
    <Reveal as="div" class="service-hero__content" distance="small">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="service-hero__introduction">{introduction}</p>
      <div class="service-hero__actions">
        <AvailabilityLink placement="page" {inquiry} />
        <ButtonLink href="/contacto" variant="secondary">
          Hablar sobre mi proyecto
        </ButtonLink>
      </div>
    </Reveal>

    <Reveal as="div" class="service-hero__editorial" delay={160}>
      <div class="service-hero__frame" aria-hidden="true">
        <span>01</span>
        <strong>EE</strong>
      </div>
      <div class="service-hero__caption">
        <span>{media?.kicker ?? "Dirección visual"}</span>
        <p>{media?.title ?? "Luz, intención y una entrega cuidada."}</p>
      </div>
    </Reveal>
  </div>
</section>

<style>
  .service-hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 78% 20%,
        rgb(223 185 88 / 24%),
        transparent 30%
      ),
      linear-gradient(135deg, var(--color-paper), var(--color-ivory));
    color: var(--color-ink);
  }

  .service-hero::before {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(11 11 12 / 3%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(11 11 12 / 3%) 1px, transparent 1px);
    background-size: 5rem 5rem;
    content: "";
    mask-image: linear-gradient(to bottom, black, transparent 90%);
    pointer-events: none;
  }

  .service-hero__grid {
    position: relative;
    display: grid;
    min-height: min(52rem, calc(100svh - 4.75rem));
    align-items: center;
    gap: clamp(3rem, 8vw, 7rem);
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }

  :global(.service-hero__content) {
    display: grid;
    gap: 1.45rem;
  }

  h1 {
    max-width: 49rem;
    font-size: clamp(3.2rem, 8.5vw, 7.2rem);
    letter-spacing: -0.06em;
  }

  .service-hero__introduction {
    max-width: 40rem;
    color: var(--color-muted);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
  }

  .service-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    padding-top: 0.5rem;
  }

  :global(.service-hero__editorial) {
    position: relative;
    display: grid;
    min-height: 24rem;
    align-content: end;
    padding: 1.25rem;
    overflow: hidden;
    border: 1px solid rgb(11 11 12 / 10%);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(145deg, rgb(255 255 255 / 72%), transparent 48%),
      linear-gradient(160deg, #eedfbf, #c99536);
    box-shadow: 0 2rem 5rem rgb(89 60 13 / 12%);
  }

  .service-hero__frame {
    position: absolute;
    inset: 1.25rem;
    display: grid;
    place-items: center;
    border: 1px solid rgb(11 11 12 / 16%);
    border-radius: calc(var(--radius-lg) - 0.4rem);
  }

  .service-hero__frame::before,
  .service-hero__frame::after {
    position: absolute;
    right: -5%;
    left: -5%;
    height: 2rem;
    border-block: 0.38rem dotted rgb(11 11 12 / 24%);
    content: "";
  }

  .service-hero__frame::before {
    top: 1rem;
  }

  .service-hero__frame::after {
    bottom: 1rem;
  }

  .service-hero__frame span {
    position: absolute;
    top: 3.2rem;
    left: 1rem;
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.16em;
  }

  .service-hero__frame strong {
    font-family: var(--font-display);
    font-size: clamp(6rem, 16vw, 11rem);
    font-weight: 500;
    letter-spacing: -0.1em;
    opacity: 0.62;
  }

  .service-hero__caption {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.2rem;
    padding: 1rem;
    border-radius: var(--radius-md);
    background: rgb(255 253 248 / 82%);
    backdrop-filter: blur(0.7rem);
  }

  .service-hero__caption span {
    color: var(--color-gold);
    font-size: 0.65rem;
    font-weight: 750;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .service-hero__caption p {
    font-family: var(--font-display);
    font-size: 1.2rem;
  }

  @media (min-width: 62rem) {
    .service-hero__grid {
      min-height: min(52rem, calc(100svh - 5.5rem));
      grid-template-columns: minmax(0, 1.25fr) minmax(22rem, 0.75fr);
    }

    :global(.service-hero__editorial) {
      min-height: 38rem;
    }
  }
</style>
