---
import type { AvailabilityInquiry } from "../../../lib/whatsapp";
import Reveal from "../../motion/Reveal.astro";
import AvailabilityLink from "../../ui/AvailabilityLink.astro";

interface Props {
  title: string;
  body: string;
  inquiry?: AvailabilityInquiry;
  tone?: "dark" | "light";
}

const { title, body, inquiry, tone = "dark" } = Astro.props;
---

<section
  class:list={["closing-cta", `closing-cta--${tone}`, "site-section"]}
  data-home-section="closing"
>
  <Reveal as="div" class="closing-cta__inner site-container">
    <p class="eyebrow">Consulta disponibilidad</p>
    <h2>{title}</h2>
    <p>{body}</p>
    <AvailabilityLink placement="page" {inquiry} />
  </Reveal>
</section>

<style>
  .closing-cta {
    position: relative;
    overflow: hidden;
    text-align: center;
  }

  .closing-cta--dark {
    border-block: 1px solid rgb(214 171 91 / 30%);
    background:
      radial-gradient(
        circle at 50% 110%,
        rgb(201 132 46 / 46%),
        transparent 38%
      ),
      radial-gradient(
        circle at 85% 15%,
        rgb(214 171 91 / 15%),
        transparent 24%
      ),
      var(--gradient-dark);
    color: var(--color-ivory);
  }

  .closing-cta--dark :global(.eyebrow) {
    color: var(--color-gold-bright);
  }

  .closing-cta--dark::before,
  .closing-cta--dark::after {
    position: absolute;
    right: 0;
    left: 0;
    height: 0.55rem;
    background: repeating-linear-gradient(
      90deg,
      transparent 0 1rem,
      rgb(255 250 241 / 40%) 1rem 1.65rem
    );
    content: "";
    pointer-events: none;
  }

  .closing-cta--dark::before {
    top: 0.65rem;
  }

  .closing-cta--dark::after {
    bottom: 0.65rem;
  }

  .closing-cta--light {
    background: var(--color-ivory);
    color: var(--color-ink);
  }

  :global(.closing-cta__inner) {
    position: relative;
    z-index: 1;
    display: grid;
    max-width: 58rem;
    justify-items: center;
    gap: 1.4rem;
  }

  h2 {
    font-size: clamp(3rem, 8vw, 7rem);
    letter-spacing: -0.055em;
  }

  h2 + p {
    max-width: 38rem;
    color: color-mix(in srgb, currentColor 68%, transparent);
    font-size: 1.1rem;
  }
</style>
