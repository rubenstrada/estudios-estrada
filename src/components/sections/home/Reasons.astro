---
import { reasons } from "../../../content/home";
import Reveal from "../../motion/Reveal.astro";
import SectionHeading from "../../ui/SectionHeading.astro";
---

<section
  class="reasons site-section site-section--paper"
  data-home-section="reasons"
>
  <div class="site-container">
    <Reveal as="div">
      <SectionHeading
        eyebrow="Nuestra forma de trabajar"
        title="Claridad antes, durante y después de producir."
      />
    </Reveal>

    <ol class="reasons__list">
      {reasons.map((reason, index) => (
        <Reveal
          as="li"
          delay={((index % 4) * 80) as 0 | 80 | 160 | 240}
          distance="small"
        >
          <span>{String(index + 1).padStart(2, "0")}</span>
          <div>
            <h3>{reason.title}</h3>
            <p>{reason.description}</p>
          </div>
        </Reveal>
      ))}
    </ol>
  </div>
</section>

<style>
  .reasons {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(90deg, rgb(121 84 50 / 5%) 1px, transparent 1px),
      var(--color-paper);
    background-size: min(25vw, 19rem) 100%;
  }

  .reasons::after {
    position: absolute;
    top: 0;
    right: clamp(1rem, 4vw, 4rem);
    width: 0.55rem;
    height: 6rem;
    background: var(--color-gold);
    content: "";
    opacity: 0.72;
  }

  .reasons__list {
    display: grid;
    margin: clamp(3rem, 7vw, 6rem) 0 0;
    padding: 0;
    border-top: 1px solid var(--color-border-strong);
    list-style: none;
  }

  .reasons__list :global(.reveal) {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding-block: 1.6rem;
    border-bottom: 1px solid var(--color-border);
  }

  .reasons__list span {
    color: var(--color-sepia);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
  }

  h3 {
    font-size: clamp(1.65rem, 3vw, 2.4rem);
  }

  h3 + p {
    max-width: 34rem;
    margin-top: 0.65rem;
    color: var(--color-muted);
  }

  @media (min-width: 54rem) {
    .reasons__list {
      grid-template-columns: repeat(2, 1fr);
      border-left: 1px solid var(--color-border);
    }

    .reasons__list :global(.reveal) {
      min-height: 12rem;
      padding: 2rem;
      border-right: 1px solid var(--color-border);
    }
  }

  @media (min-width: 72rem) {
    .reasons__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
