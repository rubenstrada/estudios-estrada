---
import Reveal from "../../motion/Reveal.astro";
---

<section
  class="company-introduction site-section"
  data-home-section="introduction"
>
  <div class="company-introduction__grid site-container">
    <Reveal as="div" distance="small">
      <p class="eyebrow">La imagen como parte de tu historia</p>
    </Reveal>
    <Reveal as="div" delay={80}>
      <h2>Una empresa para proyectos que merecen atención.</h2>
      <p>
        En Estudios Estrada reunimos fotografía y producción audiovisual para
        atender desde una sesión personal hasta la cobertura de un evento o la
        comunicación visual de una empresa. Escuchamos, planeamos y producimos
        de acuerdo con lo que cada proyecto necesita.
      </p>
    </Reveal>
    <Reveal
      as="ul"
      class="company-introduction__disciplines"
      delay={160}
      distance="small"
    >
      <li>
        <span>01</span> Fotografía
      </li>
      <li>
        <span>02</span> Eventos
      </li>
      <li>
        <span>03</span> Video
      </li>
    </Reveal>
  </div>
</section>

<style>
  .company-introduction {
    position: relative;
    background: var(--color-paper);
  }

  .company-introduction::before {
    position: absolute;
    top: clamp(2rem, 5vw, 4rem);
    left: 50%;
    width: min(calc(100% - 2rem), var(--container));
    height: 1px;
    transform: translateX(-50%);
    background: linear-gradient(90deg, var(--color-gold), transparent 40%);
    content: "";
  }

  .company-introduction__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  h2 {
    max-width: 52rem;
    font-size: clamp(2.8rem, 6.5vw, 5.9rem);
    letter-spacing: -0.05em;
  }

  h2 + p {
    max-width: 42rem;
    margin-top: 1.75rem;
    color: var(--color-muted);
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
  }

  :global(.company-introduction__disciplines) {
    display: grid;
    margin: 1rem 0 0;
    padding: 0;
    border-top: 1px solid var(--color-border-strong);
    list-style: none;
  }

  .company-introduction__disciplines li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-display);
    font-size: 1.5rem;
  }

  .company-introduction__disciplines span {
    color: var(--color-sepia);
    font-family: var(--font-body);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
  }

  @media (min-width: 64rem) {
    .company-introduction__grid {
      grid-template-columns: 0.55fr 2fr 0.75fr;
      align-items: start;
    }

    :global(.company-introduction__disciplines) {
      margin-top: 0;
    }
  }
</style>
