---
import { services } from "../../../content/services";
import Reveal from "../../motion/Reveal.astro";
import ButtonLink from "../../ui/ButtonLink.astro";
import SectionHeading from "../../ui/SectionHeading.astro";

const linkLabels = {
  fotografia: "Conocer fotografía",
  eventos: "Conocer eventos",
  video: "Conocer video",
};
---

<section
  id="servicios"
  class="service-choices site-section"
  data-home-section="services"
>
  <div class="site-container">
    <Reveal as="div">
      <SectionHeading
        eyebrow="Servicios"
        title="Una mirada profesional para cada proyecto."
        description="Elige el punto de partida. Definimos contigo el alcance, la cobertura y las entregas antes de producir."
      />
    </Reveal>

    <div class="service-choices__grid">
      {services.map((service, index) => (
        <Reveal as="article" delay={index === 0 ? 0 : index === 1 ? 80 : 160}>
          <div
            class:list={[
              "service-card__visual",
              `service-card__visual--${service.id}`,
            ]}
            aria-hidden="true"
          >
            <span>{String(index + 1).padStart(2, "0")}</span>
            <b>EE</b>
          </div>
          <div class="service-card__body">
            <p class="eyebrow">{service.eyebrow}</p>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <ButtonLink href={service.href} variant="text">
              {linkLabels[service.id]}
            </ButtonLink>
          </div>
        </Reveal>
      ))}
    </div>
  </div>
</section>

<style>
  .service-choices {
    border-block: 1px solid var(--color-border);
    background:
      radial-gradient(
        circle at 12% 10%,
        rgb(216 189 145 / 28%),
        transparent 24rem
      ),
      var(--color-ivory);
  }

  .service-choices__grid {
    display: grid;
    gap: 1rem;
    margin-top: clamp(3rem, 7vw, 6rem);
  }

  .service-choices__grid :global(.reveal) {
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    border-radius: 0.35rem;
    background: var(--color-paper);
    box-shadow: var(--shadow-card);
    transition:
      transform 220ms ease,
      box-shadow 220ms ease;
  }

  .service-choices__grid :global(.reveal):hover {
    transform: translateY(-0.35rem);
    box-shadow: 0 1.75rem 4rem rgb(96 66 39 / 14%);
  }

  .service-card__visual {
    position: relative;
    display: grid;
    min-height: 15rem;
    place-items: center;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    background:
      radial-gradient(
        circle at 65% 38%,
        rgb(255 250 241 / 82%),
        transparent 19%
      ),
      linear-gradient(145deg, #ead5b3, #ba8644);
    color: var(--color-ink);
  }

  .service-card__visual::before,
  .service-card__visual::after {
    position: absolute;
    right: -10%;
    left: -10%;
    height: 2.5rem;
    height: 1rem;
    border-block: 0;
    background: repeating-linear-gradient(
      90deg,
      var(--color-paper) 0 0.7rem,
      transparent 0.7rem 1.45rem
    );
    opacity: 0.8;
    content: "";
  }

  .service-card__visual::before {
    top: 1.25rem;
  }

  .service-card__visual::after {
    bottom: 1.25rem;
  }

  .service-card__visual span {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 2;
    color: var(--color-sepia);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
  }

  .service-card__visual b {
    font-family: var(--font-display);
    font-size: clamp(5rem, 12vw, 8rem);
    font-weight: 500;
    letter-spacing: -0.08em;
    opacity: 0.68;
    text-shadow: 0 1rem 2rem rgb(77 48 25 / 12%);
  }

  .service-card__visual--eventos {
    background:
      radial-gradient(
        circle at 38% 42%,
        rgb(255 250 241 / 76%),
        transparent 18%
      ),
      linear-gradient(135deg, #d9ba87, #f2e7d5 54%, #b9874c);
  }

  .service-card__visual--video {
    background:
      linear-gradient(
        55deg,
        transparent 0 43%,
        rgb(255 250 241 / 65%) 43% 59%,
        transparent 59%
      ),
      linear-gradient(145deg, #b98441, #ead5ae 52%, #8e6237);
  }

  .service-card__body {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: clamp(1.5rem, 3vw, 2rem);
  }

  h3 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    letter-spacing: -0.035em;
  }

  h3 + p {
    color: var(--color-muted);
  }

  @media (min-width: 48rem) {
    .service-choices__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .service-card__visual {
      min-height: 20rem;
    }
  }
</style>
