---
import Reveal from "../../motion/Reveal.astro";
import AvailabilityLink from "../../ui/AvailabilityLink.astro";
import BrandLogo from "../../ui/BrandLogo.astro";
import ButtonLink from "../../ui/ButtonLink.astro";
---

<section class="home-hero" data-home-section="hero">
  <div class="home-hero__grid site-container">
    <Reveal as="div" class="home-hero__content" distance="small">
      <p class="eyebrow">Estudios Estrada · Fotografía y video</p>
      <h1>Fotografía y producción audiovisual para momentos que importan.</h1>
      <p class="home-hero__lead">
        Somos una empresa dedicada a crear imágenes profesionales y a documentar
        eventos con planeación, sensibilidad y una entrega cuidada.
      </p>
      <div class="home-hero__actions">
        <div data-primary-home-cta>
          <AvailabilityLink placement="page" />
        </div>
        <ButtonLink href="#servicios" variant="secondary">
          Conocer servicios
        </ButtonLink>
      </div>
    </Reveal>

    <Reveal as="div" class="home-hero__mark" delay={160}>
      <div class="home-hero__frame" aria-hidden="true">
        <span>Imagen</span>
        <span>Memoria</span>
      </div>
      <BrandLogo variant="gold" priority class="home-hero__logo" />
      <p>EST. / MX</p>
    </Reveal>
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    overflow: hidden;
    min-height: calc(100svh - 4.75rem);
    background: var(--gradient-dark);
    color: var(--color-ivory);
  }

  .home-hero::before {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 3%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 3%) 1px, transparent 1px);
    background-size: 4rem 4rem;
    content: "";
    mask-image: linear-gradient(to bottom, black, transparent 85%);
    pointer-events: none;
  }

  .home-hero__grid {
    position: relative;
    display: grid;
    min-height: inherit;
    align-items: center;
    gap: 2rem;
    padding-block: clamp(4rem, 9vw, 8rem);
  }

  :global(.home-hero__content) {
    display: grid;
    max-width: 48rem;
    gap: 1.5rem;
  }

  h1 {
    max-width: 54rem;
    font-size: clamp(3.15rem, 9vw, 7.4rem);
    letter-spacing: -0.055em;
  }

  .home-hero__lead {
    max-width: 39rem;
    color: rgb(246 242 233 / 72%);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    padding-top: 0.5rem;
  }

  :global(.home-hero__mark) {
    position: relative;
    display: grid;
    min-height: 24rem;
    place-items: center;
  }

  :global(.home-hero__logo) {
    position: relative;
    z-index: 1;
    width: min(82vw, 31rem);
    height: auto;
    filter: drop-shadow(0 2rem 4rem rgb(0 0 0 / 35%));
  }

  .home-hero__frame {
    position: absolute;
    inset: 0.5rem;
    border: 1px solid rgb(223 185 88 / 34%);
    border-radius: 50% 50% 46% 54% / 55% 45% 55% 45%;
  }

  .home-hero__frame span {
    position: absolute;
    color: rgb(223 185 88 / 66%);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .home-hero__frame span:first-child {
    top: 18%;
    right: -0.75rem;
    transform: rotate(90deg);
  }

  .home-hero__frame span:last-child {
    bottom: 16%;
    left: -1.15rem;
    transform: rotate(-90deg);
  }

  .home-hero__mark > p {
    position: absolute;
    right: 0;
    bottom: 0;
    color: rgb(246 242 233 / 45%);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
  }

  @media (min-width: 62rem) {
    .home-hero {
      min-height: calc(100svh - 5.5rem);
    }

    .home-hero__grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(22rem, 0.7fr);
      gap: 3rem;
    }

    :global(.home-hero__mark) {
      min-height: 36rem;
    }

    :global(.home-hero__logo) {
      width: min(34vw, 32rem);
    }
  }

  @media (min-width: 62rem) and (max-height: 46rem) {
    .home-hero__grid {
      padding-block: 2.5rem;
    }

    h1 {
      font-size: clamp(3.8rem, 6.5vw, 5.2rem);
    }

    :global(.home-hero__mark) {
      min-height: 28rem;
    }
  }
</style>
