---
import Reveal from "../../motion/Reveal.astro";
import AvailabilityLink from "../../ui/AvailabilityLink.astro";
import BrandLogo from "../../ui/BrandLogo.astro";
import ButtonLink from "../../ui/ButtonLink.astro";
---

<section class="home-hero" data-home-section="hero">
  <div class="home-hero__grid site-container">
    <Reveal as="div" class="home-hero__content" distance="small">
      <p class="eyebrow">Estudios Estrada · Fotografía y video</p>
      <h1>Fotografía y producción audiovisual para momentos que importan.</h1>
      <p class="home-hero__lead">
        Somos una empresa dedicada a crear imágenes profesionales y a documentar
        eventos con planeación, sensibilidad y una entrega cuidada.
      </p>
      <div class="home-hero__actions">
        <div data-primary-home-cta>
          <AvailabilityLink placement="page" />
        </div>
        <ButtonLink href="#servicios" variant="secondary">
          Conocer servicios
        </ButtonLink>
      </div>
    </Reveal>

    <Reveal as="div" class="home-hero__mark" delay={160}>
      <div class="home-hero__frame" aria-hidden="true">
        <span>Imagen</span>
        <span>Memoria</span>
      </div>
      <BrandLogo variant="dark-amber" priority class="home-hero__logo" />
      <p>EST. / MX</p>
    </Reveal>
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    overflow: hidden;
    min-height: calc(100svh - 4.75rem);
    border-bottom: 1px solid var(--color-border);
    background: var(--gradient-paper);
    color: var(--color-ink);
  }

  .home-hero::before {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(121 84 50 / 5%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(121 84 50 / 5%) 1px, transparent 1px);
    background-size: 5rem 5rem;
    content: "";
    mask-image: linear-gradient(to bottom, black, transparent 92%);
    pointer-events: none;
  }

  .home-hero::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 0.45rem;
    background: repeating-linear-gradient(
      90deg,
      transparent 0 1.1rem,
      var(--color-gold) 1.1rem 1.75rem
    );
    content: "";
    opacity: 0.55;
    pointer-events: none;
  }

  .home-hero__grid {
    position: relative;
    display: grid;
    min-height: inherit;
    align-items: center;
    gap: 2rem;
    padding-block: clamp(4rem, 9vw, 8rem);
  }

  :global(.home-hero__content) {
    display: grid;
    max-width: 48rem;
    gap: 1.5rem;
  }

  h1 {
    max-width: 54rem;
    font-size: clamp(3.15rem, 8vw, 6.9rem);
    letter-spacing: -0.055em;
  }

  .home-hero__lead {
    max-width: 39rem;
    color: var(--color-muted);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    padding-top: 0.5rem;
  }

  :global(.home-hero__mark) {
    position: relative;
    display: grid;
    min-height: 24rem;
    place-items: center;
    overflow: hidden;
    padding: clamp(2rem, 5vw, 4rem);
    border: 1px solid var(--color-border-strong);
    border-radius: 45% 45% 1.2rem 1.2rem / 22% 22% 1.2rem 1.2rem;
    background:
      radial-gradient(circle at 58% 30%, rgb(255 250 241 / 74%), transparent 26%),
      linear-gradient(145deg, #ead6b6 0%, #c99d5d 54%, #f7ecd9 100%);
    box-shadow: var(--shadow-soft);
  }

  :global(.home-hero__mark)::before,
  :global(.home-hero__mark)::after {
    position: absolute;
    z-index: 2;
    top: 1rem;
    bottom: 1rem;
    width: 0.55rem;
    background: repeating-linear-gradient(
      to bottom,
      var(--color-paper) 0 0.8rem,
      transparent 0.8rem 1.5rem
    );
    content: "";
    opacity: 0.88;
  }

  :global(.home-hero__mark)::before {
    left: 0.65rem;
  }

  :global(.home-hero__mark)::after {
    right: 0.65rem;
  }

  :global(.home-hero__logo) {
    position: relative;
    z-index: 1;
    width: min(72vw, 27rem);
    height: auto;
    filter: drop-shadow(0 1.5rem 2.5rem rgb(73 44 20 / 18%));
  }

  .home-hero__frame {
    position: absolute;
    inset: 1.45rem;
    border: 1px solid rgb(73 44 20 / 26%);
    border-radius: calc(45% - 0.65rem) calc(45% - 0.65rem) 0.55rem 0.55rem /
      calc(22% - 0.25rem) calc(22% - 0.25rem) 0.55rem 0.55rem;
  }

  .home-hero__frame span {
    position: absolute;
    color: rgb(73 44 20 / 62%);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .home-hero__frame span:first-child {
    top: 18%;
    right: -0.75rem;
    transform: rotate(90deg);
  }

  .home-hero__frame span:last-child {
    bottom: 16%;
    left: -1.15rem;
    transform: rotate(-90deg);
  }

  .home-hero__mark > p {
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 3;
    right: 1.25rem;
    bottom: 0.85rem;
    color: rgb(73 44 20 / 55%);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
  }

  @media (min-width: 62rem) {
    .home-hero {
      min-height: calc(100svh - 5.5rem);
    }

    .home-hero__grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(22rem, 0.7fr);
      gap: clamp(3rem, 6vw, 7rem);
    }

    :global(.home-hero__mark) {
      min-height: 36rem;
    }

    :global(.home-hero__logo) {
      width: min(30vw, 26rem);
    }
  }

  @media (min-width: 62rem) and (max-height: 46rem) {
    .home-hero__grid {
      padding-block: 2.5rem;
    }

    h1 {
      font-size: clamp(3.8rem, 6.5vw, 5.2rem);
    }

    :global(.home-hero__mark) {
      min-height: 28rem;
    }
  }
</style>
