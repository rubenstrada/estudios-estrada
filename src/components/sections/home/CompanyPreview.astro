---
import Reveal from "../../motion/Reveal.astro";
import BrandLogo from "../../ui/BrandLogo.astro";
import ButtonLink from "../../ui/ButtonLink.astro";
---

<section class="company-preview site-section" data-home-section="company">
  <div class="company-preview__grid site-container">
    <Reveal as="div" class="company-preview__mark">
      <BrandLogo variant="dark-amber" class="company-preview__logo" />
      <div class="company-preview__frames" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <p>Fotografía · video · eventos</p>
    </Reveal>

    <Reveal as="div" class="company-preview__content" delay={80}>
      <p class="eyebrow">Quiénes somos</p>
      <h2>Un estudio que se integra a tu proyecto.</h2>
      <p>
        Nos interesa entender qué necesitas comunicar o conservar. Por eso
        nuestro trabajo comienza con una conversación y continúa con un proceso
        ordenado de producción, edición y entrega.
      </p>
      <ButtonLink href="/quienes-somos" variant="text">
        Conocer Estudios Estrada
      </ButtonLink>
    </Reveal>
  </div>
</section>

<style>
  .company-preview {
    overflow: hidden;
    border-top: 1px solid var(--color-border);
    background:
      radial-gradient(
        circle at 78% 18%,
        rgb(232 209 164 / 32%),
        transparent 22rem
      ),
      var(--color-ivory);
  }

  .company-preview__grid {
    display: grid;
    align-items: center;
    gap: 3rem;
  }

  :global(.company-preview__mark) {
    position: relative;
    display: grid;
    min-height: 24rem;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    border-radius: 0.45rem;
    background:
      linear-gradient(rgb(121 84 50 / 5%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(121 84 50 / 5%) 1px, transparent 1px),
      linear-gradient(150deg, #f6ebd9, #d6aa68 180%);
    background-size:
      3.5rem 3.5rem,
      3.5rem 3.5rem,
      auto;
    box-shadow: var(--shadow-card);
  }

  .company-preview__mark::before {
    position: absolute;
    width: 86%;
    aspect-ratio: 1;
    border: 1px solid rgb(11 11 12 / 12%);
    border-radius: 50%;
    content: "";
  }

  :global(.company-preview__logo) {
    position: relative;
    z-index: 2;
    width: min(78%, 25rem);
    height: auto;
  }

  .company-preview__frames {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .company-preview__frames span {
    position: absolute;
    width: 7rem;
    aspect-ratio: 4 / 3;
    border: 0.35rem solid var(--color-paper);
    background: linear-gradient(135deg, #b98240, #eedbbb);
    box-shadow: 0 0.75rem 2rem rgb(73 44 20 / 16%);
  }

  .company-preview__frames span:nth-child(1) {
    top: 8%;
    right: 6%;
    transform: rotate(7deg);
  }

  .company-preview__frames span:nth-child(2) {
    bottom: 9%;
    left: 5%;
    transform: rotate(-8deg);
  }

  .company-preview__frames span:nth-child(3) {
    right: 10%;
    bottom: 15%;
    width: 5rem;
    transform: rotate(4deg);
  }

  .company-preview__mark > p {
    position: absolute;
    z-index: 4;
    bottom: 1rem;
    padding: 0.3rem 0.55rem;
    border: 1px solid rgb(121 84 50 / 18%);
    background: rgb(255 250 241 / 84%);
    color: var(--color-sepia);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  :global(.company-preview__content) {
    display: grid;
    gap: 1.25rem;
  }

  h2 {
    font-size: clamp(2.6rem, 6vw, 5.5rem);
    letter-spacing: -0.05em;
  }

  h2 + p {
    max-width: 38rem;
    color: var(--color-muted);
    font-size: 1.1rem;
  }

  @media (min-width: 56rem) {
    .company-preview__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: clamp(3rem, 7vw, 7rem);
    }

    :global(.company-preview__mark) {
      min-height: 35rem;
    }
  }
</style>
