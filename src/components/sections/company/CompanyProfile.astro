---
import { companyPrinciples, companyStory } from "../../../content/company";
import Reveal from "../../motion/Reveal.astro";
import SectionHeading from "../../ui/SectionHeading.astro";
---

<section class="company-profile site-section">
  <div class="company-profile__story site-container">
    <Reveal as="div">
      <SectionHeading eyebrow="Cómo trabajamos" title={companyStory.title} />
    </Reveal>
    <Reveal as="div" class="company-profile__copy" delay={80}>
      {companyStory.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </Reveal>
  </div>

  <div class="company-profile__principles site-container">
    {companyPrinciples.map((principle, index) => (
      <Reveal
        as="article"
        delay={((index % 4) * 80) as 0 | 80 | 160 | 240}
        distance="small"
        data-company-principle
      >
        <span>{String(index + 1).padStart(2, "0")}</span>
        <h2>{principle.title}</h2>
        <p>{principle.description}</p>
      </Reveal>
    ))}
  </div>
</section>

<style>
  .company-profile {
    background: var(--color-paper);
  }

  .company-profile__story {
    display: grid;
    gap: 2rem;
  }

  :global(.company-profile__copy) {
    display: grid;
    max-width: 44rem;
    gap: 1rem;
    color: var(--color-muted);
    font-size: clamp(1.05rem, 1.8vw, 1.22rem);
  }

  .company-profile__principles {
    display: grid;
    margin-top: clamp(4rem, 9vw, 7rem);
    border-top: 1px solid var(--color-border-strong);
  }

  .company-profile__principles :global([data-company-principle]) {
    display: grid;
    align-content: start;
    gap: 0.8rem;
    padding-block: 1.6rem;
    border-bottom: 1px solid var(--color-border);
  }

  .company-profile__principles span {
    color: var(--color-sepia);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
  }

  .company-profile__principles h2 {
    font-size: clamp(1.8rem, 3vw, 2.7rem);
  }

  .company-profile__principles p {
    color: var(--color-muted);
  }

  @media (min-width: 54rem) {
    .company-profile__story {
      grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr);
      align-items: end;
    }

    .company-profile__principles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-left: 1px solid var(--color-border);
    }

    .company-profile__principles :global([data-company-principle]) {
      min-height: 15rem;
      padding: 2rem;
      border-right: 1px solid var(--color-border);
    }
  }

  @media (min-width: 72rem) {
    .company-profile__principles {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
