---
import ServiceCategoryGrid from "../components/sections/services/ServiceCategoryGrid.astro";
import ServiceHero from "../components/sections/services/ServiceHero.astro";
import ServiceProcess from "../components/sections/services/ServiceProcess.astro";
import ClosingCta from "../components/sections/shared/ClosingCta.astro";
import { pageSeo } from "../content/pages";
import { eventVideoProcess, eventVideoService } from "../content/services";
import BaseLayout from "../layouts/BaseLayout.astro";

const seo = pageSeo["/eventos-y-video"];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalPath="/eventos-y-video"
>
  <ServiceHero
    eyebrow={eventVideoService.eyebrow}
    title={eventVideoService.title}
    introduction={eventVideoService.introduction}
    inquiry={{ service: "evento-video" }}
  />
  <ServiceCategoryGrid
    categories={eventVideoService.categories}
    eyebrow="Servicios para eventos"
    title="Elige la cobertura que necesita tu evento."
    description="Puedes contratar fotografía, video o ambos servicios. Adaptamos el equipo y las entregas al formato y la duración del evento."
  />
  <ServiceProcess
    steps={eventVideoProcess}
    eyebrow="Cómo trabajamos"
    title="Planeamos la cobertura antes del evento."
    description="Definimos horarios, responsables, momentos prioritarios y necesidades técnicas para que el equipo llegue preparado."
  />
  <ClosingCta
    title="Consulta disponibilidad para tu evento."
    body="Compártenos el tipo de evento, la fecha, el lugar y si necesitas fotografía, video o ambos servicios. Revisaremos contigo la cobertura y las entregas."
    inquiry={{ service: "evento-video" }}
  />
</BaseLayout>
