---
import ContactDetails from "../components/sections/contact/ContactDetails.astro";
import EditorialPageHero from "../components/sections/shared/EditorialPageHero.astro";
import { pageSeo } from "../content/pages";
import BaseLayout from "../layouts/BaseLayout.astro";

const seo = pageSeo["/contacto"];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalPath="/contacto"
>
  <EditorialPageHero
    eyebrow="Contacto"
    title="Conversemos sobre lo que quieres producir."
    introduction="Compártenos tu idea, la fecha y el tipo de servicio que necesitas. Con esa información podremos orientarte con claridad y preparar una propuesta adecuada."
    index="05"
    caption="Fotografía · eventos · producción audiovisual"
  />
  <ContactDetails />
</BaseLayout>
