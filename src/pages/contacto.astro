---
import ContactDetails from "../components/sections/contact/ContactDetails.astro";
import EditorialPageHero from "../components/sections/shared/EditorialPageHero.astro";
import { pageSeo } from "../content/pages";
import BaseLayout from "../layouts/BaseLayout.astro";

const seo = pageSeo["/contacto"];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalPath="/contacto"
>
  <EditorialPageHero
    eyebrow="Contacto"
    title="Cuéntanos qué servicio necesitas."
    introduction="Comparte el tipo de sesión, evento o producción, la fecha y la ubicación. Con esa información podremos revisar disponibilidad y preparar una propuesta adecuada."
    index="05"
    caption="Fotografía · eventos · producción audiovisual"
  />
  <ContactDetails />
</BaseLayout>
