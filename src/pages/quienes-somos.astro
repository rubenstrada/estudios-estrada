---
import teamPhoto from "../assets/company/equipo-estudios-estrada.png";
import CompanyProfile from "../components/sections/company/CompanyProfile.astro";
import ClosingCta from "../components/sections/shared/ClosingCta.astro";
import EditorialPageHero from "../components/sections/shared/EditorialPageHero.astro";
import { pageSeo } from "../content/pages";
import BaseLayout from "../layouts/BaseLayout.astro";

const seo = pageSeo["/quienes-somos"];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalPath="/quienes-somos"
>
  <EditorialPageHero
    eyebrow="Quiénes somos"
    title="Un equipo de fotografía y video para tu proyecto."
    introduction="Somos fotógrafos y realizadores audiovisuales. Planeamos y coordinamos sesiones, eventos y producciones para entregar resultados profesionales y listos para su uso."
    index="04"
    caption="Personas · marcas · productos · eventos"
    image={teamPhoto}
    imageAlt="Equipo de Estudios Estrada"
  />
  <CompanyProfile />
  <ClosingCta
    title="Cuéntanos qué necesitas producir."
    body="Comparte el tipo de servicio, la fecha y el resultado que buscas. Revisaremos contigo el equipo, el alcance y las entregas."
  />
</BaseLayout>
